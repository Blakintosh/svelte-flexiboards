{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"stripInternal": true,
		"target": "ES2023",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": [
		"src"
	]
}
