{
	"name": "root",
	"licence": "MIT",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"build:packages": "pnpm -r --filter './packages/*' build",
		"check": "pnpm build:packages && pnpm -r check",
		"check:artifacts": "node scripts/check-package-artifacts.mjs",
		"release:stage": "node scripts/stage-packages.mjs",
		"test:release": "node --test scripts/stage-packages.test.mjs",
		"dev": "pnpm -r --parallel dev",
		"dev:host": "pnpm -r --parallel dev:host",
		"format": "prettier --write .",
		"lint": "prettier --check . && pnpm -r --if-present lint",
		"preview": "pnpm -r --parallel preview",
		"lint:fix": "eslint --fix .",
		"test": "pnpm -r --parallel test",
		"changeset": "changeset",
		"version": "changeset version",
		"test:consumers": "node scripts/test-package-consumers.mjs",
		"release:check": "pnpm check && pnpm check:artifacts && pnpm -r test && pnpm test:release && pnpm lint && pnpm test:consumers && pnpm -C site check:e2e && pnpm -C site e2e"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.2",
		"@types/eslint": "^9.6.0",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"publint": "^0.2.0",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0"
	},
	"packageManager": "pnpm@11.26.0",
	"engines": {
		"node": ">=22.13.0"
	}
}
